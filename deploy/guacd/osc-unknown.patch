+int guac_terminal_unknown_osc(guac_terminal* term, unsigned char c) {
+
+    /* Swallow the text of an OSC guacd does not act on (icon name, current
+     * directory, hyperlinks...) until ECMA-48 ST or BEL, as newer guacd does */
+    if (c == 0x9C || c == 0x5C || c == 0x07)
+        term->char_handler = guac_terminal_echo;
+
+    return 0;
+
+}
